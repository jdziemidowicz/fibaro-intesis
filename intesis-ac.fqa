  "files": [
    {
      "name": "main",
      "isMain": true,
      "isOpen": true,
      "content": "-- Thermostat cool should handle actions: setThermostatMode, setCoolingThermostatSetpoint\n-- Proeprties that should be updated:\n-- * supportedThermostatModes - array of modes supported by the thermostat eg. {\"Off\", \"Cool\"}\n-- * thermostatMode - current mode of the thermostat\n-- * coolingThermostatSetpoint - set point for cooling, supported units: \"C\" - Celsius, \"F\" - Fahrenheit\n\nfunction QuickApp:setThermostatMode(mode)\n  if mode == \"Off\" then\n    self:sendCommand(\"SET,1:ONOFF,OFF\")\n  else\n    self:sendCommand(\"SET,1:MODE,\" .. mode:upper())\n    self:sendCommand(\"SET,1:ONOFF,ON\")\n  end\nend\n\nfunction QuickApp:setCoolingThermostatSetpoint(value, _unit)\n  self:sendCommand(\"SET,1:SETPTEMP,\" .. math.floor(10 * value))\nend\n\nfunction QuickApp:onChangeVane()\n  if self.lastVane == \"AUTO\" then\n    self:sendCommand(\"SET,1:VANEUD,SWING\")\n  elseif self.lastVane == \"SWING\" then\n    self:sendCommand(\"SET,1:VANEUD,AUTO\")\n  end\nend\n\nfunction QuickApp:onChangeFanSpeed()\n  if self.lastFanSpeed == \"AUTO\" then\n    self:sendCommand(\"SET,1:FANSP,4\")\n  elseif self.lastFanSpeed == \"4\" then\n    self:sendCommand(\"SET,1:FANSP,3\")\n  elseif self.lastFanSpeed == \"3\" then\n    self:sendCommand(\"SET,1:FANSP,2\")\n  elseif self.lastFanSpeed == \"2\" then\n    self:sendCommand(\"SET,1:FANSP,1\")\n  elseif self.lastFanSpeed == \"1\" then\n    self:sendCommand(\"SET,1:FANSP,AUTO\")\n  end\nend\n\nfunction QuickApp:wakeUpDeadDevice()\n  self:connect()\nend\n\n-- To update controls you can use method self:updateView(<component ID>, <component property>, <desired value>). Eg:\n-- self:updateView(\"slider\", \"value\", \"55\")\n-- self:updateView(\"button1\", \"text\", \"MUTE\")\n-- self:updateView(\"label\", \"text\", \"TURNED ON\")\n\n-- This is QuickApp inital method. It is called right after your QuickApp starts (after each save or on gateway startup).\n-- Here you can set some default values, setup http connection or get QuickApp variables.\n-- To learn more, please visit:\n--    * https://manuals.fibaro.com/home-center-3/\n--    * https://manuals.fibaro.com/home-center-3-quick-apps/\n\nlocal CONNECT_TIMEOUT_SEC  = 30\nlocal PING_EVERY_SEC       = 10\nlocal RECONNECT_SEC        = 30\nlocal WMP_PORT             = 3310\n\nlocal MAGIC_LOGIN = \"\\xAB\\xCD\\xEF\\x55\\xAA\\xFE\\xDC\\xBA\"\nlocal MAGIC_M0    = \"\\xFE\\xA5\\x1B\\x1E\\x01\\x23\\x45\\x67\"\nlocal MAGIC_M1    = \"\\x5A\\xFE\\xB0\\xA7\\xBE\\xA1\\xAF\\xEA\"\n\nfunction QuickApp:onInit()\n  self:updateProperty(\"supportedThermostatModes\", {\"Cool\", \"Fan\", \"Dry\", \"Heat\", \"Auto\", \"Off\"})\n  self:updateProperty(\"coolingThermostatSetpointCapabilitiesMin\", 18)\n  self:updateProperty(\"coolingThermostatSetpointCapabilitiesMax\", 30)\n  self:updateProperty(\"coolingThermostatSetpointStep\", {C = 1.0})\n\n  self.ip = self:getVariable(\"IP\")\n  self.pin = tonumber(self:getVariable(\"PIN\"))\n\n  self:connect()\nend\n\nfunction QuickApp:connect()\n  self:resetState()\n\n  if self.ip == \"\" then\n    self:error(\"Set QuickApp variables: IP\")\n    return\n  end\n\n  self:debug(string.format(\"Connecting to %s:%d...\", self.ip, WMP_PORT))\n  self.socket = net.TCPSocket({timeout = CONNECT_TIMEOUT_SEC * 1000});\n\n  self.socket:connect(self.ip, WMP_PORT, {\n    success = function()\n      self:debug(\"TCP connected\")\n      self:updateProperty(\"dead\", false)\n      self.connected = true\n\n      self:startReader()\n\n      self:sendCommand(\"ID\")\n    end,\n    error = function(message)\n      self:warning(\"TCP connect failed: \" .. message)\n      return self:scheduleReconnect()\n    end\n  })\nend\n\nfunction QuickApp:doLogin()\n  if self.securityLevel == 'A' and not self.pin then\n    self:error(\"PIN required\")\n    self:resetState()\n    return\n  end\n\n  if self.pin then\n    self.encKey = derive_key(self.pin, tonumber(self.mac, 16))\n\n    self.r0 = random_bytes(8)\n    self:sendCommand(\"LOGIN:\" .. bytes_to_hex(aes_ecb_encrypt(self.r0 .. MAGIC_LOGIN, self.encKey)))\n  else\n    self:fetchParameters()\n  end\nend\n\nfunction QuickApp:fetchParameters()\n  if self.securityLevel == 'N' or self.pin then\n    self:sendCommand(\"CFG:DATETIME,\" .. os.date(\"%d/%m/%Y %H:%M:%S\"))\n  end\n  self:sendCommand(\"GET,1:MODE\")\n  self:sendCommand(\"GET,1:SETPTEMP\")\n  self:sendCommand(\"GET,1:VANEUD\")\n  self:sendCommand(\"GET,1:FANSP\")\n  self:sendCommand(\"GET,1:ONOFF\")\n\n  self:startPinger()\nend\n\nfunction QuickApp:resetState()\n  self:updateProperty(\"dead\", true)\n\n  if self.socket then\n    self.socket:close()\n  end\n  self.socket = nil\n  self.connected = false\n  self.lastSendTime = 0\n\n  if self.pingTimer then\n    hub.clearTimeout(self.pingTimer)\n  end\n  self.pingTimer = nil\n  if self.reconnectTimer then\n    hub.clearTimeout(self.reconnectTimer)\n  end\n  self.reconnectTimer = nil\n\n  self.waitingForResponse = false\n  self.queue = {}\n  self.lastMode = \"Cool\"\n  self.lastVane = \"AUTO\"\n  self.lastFanSpeed = \"AUTO\"\n  self.mac = nil\n  self.encKey = nil\n  self.sessionKey = nil\n  self.r0 = nil\n  self.r1 = nil\n  self.r2 = nil\n  self.rxIv = nil\n  self.txIv = nil\nend\n\nfunction QuickApp:scheduleReconnect()\n  self:resetState()\n  self:warning(string.format(\"Reconnecting in %ds...\", RECONNECT_SEC))\n\n  self.reconnectTimer = hub.setTimeout(RECONNECT_SEC * 1000, function()\n    self.reconnectTimer = nil\n    self:connect()\n  end)\nend\n\nfunction QuickApp:startReader()\n  self:readSomething(function (data)\n    self:handleIncoming(data)\n    self:startReader()\n  end)\nend\n\nfunction QuickApp:readSomething(callback)\n  if not self.socket then\n    return\n  end\n\n  self.socket:readUntil(\"\\r\\n\", {\n    success = function(data)\n      if self.sessionKey then\n        data = unescape(data)\n        data = aes_cbc_decrypt(data, self.sessionKey, self.rxIv)\n        local num2 = tonumber(data:sub(1, 4))\n        data = data:sub(6, 5 + num2 - 2)\n      end\n\n      self:debug(\"<-- \" .. data)\n\n      self.waitingForResponse = false\n      local payload = table.remove(self.queue, 1)\n      if payload then\n        self:sendCommand(payload)\n      end\n\n      callback(data)\n    end,\n    error = function(message)\n      self:warning(\"Socket read error: \" .. message)\n      self:scheduleReconnect()\n    end\n  })\nend\n\nfunction QuickApp:startPinger()\n  if self.pingTimer then\n    hub.clearTimeout(self.pingTimer)\n  end\n\n  self:pingLoop()\nend\n\nfunction QuickApp:pingLoop()\n  self.pingTimer = hub.setTimeout(PING_EVERY_SEC * 1000, function()\n    if os.time() - self.lastSendTime >= PING_EVERY_SEC then\n      self:sendCommand(\"PING\")\n    end\n    self:pingLoop()\n  end)\nend\n\nlocal function firstToUpper(str)\n  return str:sub(1, 1):upper() .. str:sub(2):lower()\nend\n\nfunction QuickApp:handleIncoming(data)\n  if data == \"CHN,1:MODE,COOL\" then\n    self.lastMode = \"Cool\"\n    self:updateProperty(\"thermostatMode\", \"Cool\")\n  elseif data == \"CHN,1:MODE,FAN\" then\n    self.lastMode = \"Fan\"\n    self:updateProperty(\"thermostatMode\", \"Fan\")\n  elseif data == \"CHN,1:MODE,DRY\" then\n    self.lastMode = \"Dry\"\n    self:updateProperty(\"thermostatMode\", \"Dry\")\n  elseif data == \"CHN,1:MODE,HEAT\" then\n    self.lastMode = \"Heat\"\n    self:updateProperty(\"thermostatMode\", \"Heat\")\n  elseif data == \"CHN,1:MODE,AUTO\" then\n    self.lastMode = \"Auto\"\n    self:updateProperty(\"thermostatMode\", \"Auto\")\n  elseif data == \"CHN,1:ONOFF,OFF\" then\n    self:updateProperty(\"thermostatMode\", \"Off\")\n  elseif data == \"CHN,1:ONOFF,ON\" then\n    self:updateProperty(\"thermostatMode\", self.lastMode)\n  elseif data == \"OK\" then\n    self.sessionKey = self.r1 .. self.r2\n    self.rxIv = { md5(self.r0) }\n    local r0Inc = {}\n    for i = 1, 8 do\n      r0Inc[i] = (self.r0:byte(i) + 1) & 0xFF\n    end\n    self.txIv = { md5(string.char(table.unpack(r0Inc))) }\n    self:fetchParameters()\n  elseif data == \"ERR\" then\n    self:error(\"invalid PIN\")\n    self:resetState()\n  elseif data:starts(\"CHN,1:VANEUD,\") then\n    local _, e = data:find(\"CHN,1:VANEUD,\", 1, true)\n    local mode = data:sub(e+1)\n    self.lastVane = mode\n    self:updateView(\"buttonVane\", \"text\", \"Vane: \" .. firstToUpper(mode))\n  elseif data:starts(\"CHN,1:FANSP,\") then\n    local _, e = data:find(\"CHN,1:FANSP,\", 1, true)\n    local speed = data:sub(e+1)\n    self.lastFanSpeed = speed\n    self:updateView(\"buttonFanSp\", \"text\", \"Fan: \" .. firstToUpper(speed))\n  elseif data:starts(\"CHN,1:SETPTEMP,\") then\n    local _, e = data:find(\"CHN,1:SETPTEMP,\", 1, true)\n    local temp = tonumber(data:sub(e+1))\n    if temp ~= 32768 then\n      self:updateProperty(\"coolingThermostatSetpoint\", {value = temp // 10, unit = \"C\"})\n    end\n  elseif data:starts(\"ID:\") then\n    local fields = {}\n    for f in (data:sub(4) .. \",\"):gmatch(\"([^,]*),\") do fields[#fields+1] = f end\n\n    self.mac = fields[2]\n    self.securityLevel = fields[8]\n    self:doLogin()\n  elseif data:starts(\"M0:\") then\n    local m0 = aes_ecb_decrypt(hex_to_bytes(data:sub(4)), self.encKey)\n    assert(m0:sub(9, 16) == MAGIC_M0, \"M0 magic mismatch: \" .. bytes_to_hex(m0:sub(9, 16)))\n    self.r1 = m0:sub(1, 8)\n    self.r2 = random_bytes(8)\n    self:sendCommand(\"M1:\" .. bytes_to_hex(aes_ecb_encrypt(self.r2 .. MAGIC_M1, self.encKey)))\n  end\nend\n\nfunction QuickApp:sendRaw(payload)\n  local data = nil\n  if self.sessionKey then\n    local buf = payload .. \"\\n\"\n    buf = (\"%04d~\"):format(#buf) .. buf\n    local cipher_out = aes_cbc_encrypt(buf, self.sessionKey, self.txIv)\n    data = escape(cipher_out, #cipher_out) .. \"\\r\\n\"\n  else\n    data = payload .. \"\\r\\n\"\n  end\n\n  self.socket:write(data, {\n    success = function()\n      self:debug(\"--> \" .. payload)\n      self.lastSendTime = os.time()\n    end,\n    error = function(message)\n      self:warning(\"Socket write error: \" .. message)\n      self:scheduleReconnect()\n    end\n  })\nend\n\nfunction QuickApp:sendCommand(payload)\n  if not self.connected then\n    self:warning(\"Not connected, cannot send\")\n    return\n  end\n\n  if not self.waitingForResponse then\n    self:sendRaw(payload)\n    self.waitingForResponse = true\n  else\n    table.insert(self.queue, payload)\n  end\nend\n"
    },
    {
      "name": "md5",
      "isMain": false,
      "isOpen": false,
      "content": "function md5(msg)\n    local msglen = #msg\n    local bitlen = msglen * 8\n\n    -- Padding: append 0x80, then zeros until length ≡ 56 (mod 64)\n    msg = msg .. \"\\x80\"\n    while #msg % 64 ~= 56 do msg = msg .. \"\\x00\" end\n    -- Append original bit-length as 64-bit little-endian\n    for i = 0, 7 do msg = msg .. string.char((bitlen >> (8 * i)) & 0xFF) end\n\n    local h0 = 0x67452301\n    local h1 = 0xEFCDAB89\n    local h2 = 0x98BADCFE\n    local h3 = 0x10325476\n\n    -- Per-round left-rotate amounts\n    local s = {\n         7, 12, 17, 22,  7, 12, 17, 22,  7, 12, 17, 22,  7, 12, 17, 22,\n         5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,\n         4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,\n         6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21,\n    }\n\n    -- T[i] = floor(2^32 * |sin(i)|), i = 1..64\n    local T = {\n        0xD76AA478, 0xE8C7B756, 0x242070DB, 0xC1BDCEEE,\n        0xF57C0FAF, 0x4787C62A, 0xA8304613, 0xFD469501,\n        0x698098D8, 0x8B44F7AF, 0xFFFF5BB1, 0x895CD7BE,\n        0x6B901122, 0xFD987193, 0xA679438E, 0x49B40821,\n        0xF61E2562, 0xC040B340, 0x265E5A51, 0xE9B6C7AA,\n        0xD62F105D, 0x02441453, 0xD8A1E681, 0xE7D3FBC8,\n        0x21E1CDE6, 0xC33707D6, 0xF4D50D87, 0x455A14ED,\n        0xA9E3E905, 0xFCEFA3F8, 0x676F02D9, 0x8D2A4C8A,\n        0xFFFA3942, 0x8771F681, 0x6D9D6122, 0xFDE5380C,\n        0xA4BEEA44, 0x4BDECFA9, 0xF6BB4B60, 0xBEBFBC70,\n        0x289B7EC6, 0xEAA127FA, 0xD4EF3085, 0x04881D05,\n        0xD9D4D039, 0xE6DB99E5, 0x1FA27CF8, 0xC4AC5665,\n        0xF4292244, 0x432AFF97, 0xAB9423A7, 0xFC93A039,\n        0x655B59C3, 0x8F0CCC92, 0xFFEFF47D, 0x85845DD1,\n        0x6FA87E4F, 0xFE2CE6E0, 0xA3014314, 0x4E0811A1,\n        0xF7537E82, 0xBD3AF235, 0x2AD7D2BB, 0xEB86D391,\n    }\n\n    -- 32-bit NOT (Lua integers are 64-bit signed)\n    local function bnot32(x) return (~x) & 0xFFFFFFFF end\n\n    for blk = 1, #msg, 64 do\n        local M = {}\n        for j = 0, 15 do\n            local p = blk + j * 4\n            M[j] = msg:byte(p)\n                 | (msg:byte(p + 1) << 8)\n                 | (msg:byte(p + 2) << 16)\n                 | (msg:byte(p + 3) << 24)\n        end\n\n        local A, B, C, D = h0, h1, h2, h3\n\n        for i = 1, 64 do\n            local F, g\n            if i <= 16 then\n                F = (B & C) | (bnot32(B) & D)\n                g = i - 1\n            elseif i <= 32 then\n                F = (D & B) | (bnot32(D) & C)\n                g = (5 * (i - 1) + 1) % 16\n            elseif i <= 48 then\n                F = B ~ C ~ D\n                g = (3 * (i - 1) + 5) % 16\n            else\n                F = C ~ (B | bnot32(D))\n                g = (7 * (i - 1)) % 16\n            end\n\n            F = (F + A + T[i] + M[g]) & 0xFFFFFFFF\n            A = D\n            D = C\n            C = B\n            local sh = s[i]\n            B = (B + (((F << sh) & 0xFFFFFFFF) | (F >> (32 - sh)))) & 0xFFFFFFFF\n        end\n\n        h0 = (h0 + A) & 0xFFFFFFFF\n        h1 = (h1 + B) & 0xFFFFFFFF\n        h2 = (h2 + C) & 0xFFFFFFFF\n        h3 = (h3 + D) & 0xFFFFFFFF\n    end\n\n    local function le32(v)\n        return string.char(v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF, (v >> 24) & 0xFF)\n    end\n    return le32(h0) .. le32(h1) .. le32(h2) .. le32(h3)\nend\n"
    },
    {
      "name": "aes",
      "isMain": false,
      "isOpen": false,
      "content": "-- ===========================================================================\n-- AES-128  (pure Lua 5.3)\n--\n-- State layout: flat 1-indexed array of 16 bytes, column-major:\n--   state[c*4 + r + 1]  where r = row (0-3), c = column (0-3)\n-- ===========================================================================\n\n-- Forward S-box (0-indexed)\nlocal SBOX = {[0]=\n    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,\n    0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,\n    0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,\n    0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,\n    0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,\n    0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,\n    0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,\n    0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,\n    0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,\n    0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,\n    0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,\n    0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,\n    0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,\n    0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,\n    0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,\n    0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16,\n}\n\n-- Inverse S-box (0-indexed)\nlocal ISBOX = {[0]=\n    0x52,0x09,0x6a,0xd5,0x30,0x36,0xa5,0x38,0xbf,0x40,0xa3,0x9e,0x81,0xf3,0xd7,0xfb,\n    0x7c,0xe3,0x39,0x82,0x9b,0x2f,0xff,0x87,0x34,0x8e,0x43,0x44,0xc4,0xde,0xe9,0xcb,\n    0x54,0x7b,0x94,0x32,0xa6,0xc2,0x23,0x3d,0xee,0x4c,0x95,0x0b,0x42,0xfa,0xc3,0x4e,\n    0x08,0x2e,0xa1,0x66,0x28,0xd9,0x24,0xb2,0x76,0x5b,0xa2,0x49,0x6d,0x8b,0xd1,0x25,\n    0x72,0xf8,0xf6,0x64,0x86,0x68,0x98,0x16,0xd4,0xa4,0x5c,0xcc,0x5d,0x65,0xb6,0x92,\n    0x6c,0x70,0x48,0x50,0xfd,0xed,0xb9,0xda,0x5e,0x15,0x46,0x57,0xa7,0x8d,0x9d,0x84,\n    0x90,0xd8,0xab,0x00,0x8c,0xbc,0xd3,0x0a,0xf7,0xe4,0x58,0x05,0xb8,0xb3,0x45,0x06,\n    0xd0,0x2c,0x1e,0x8f,0xca,0x3f,0x0f,0x02,0xc1,0xaf,0xbd,0x03,0x01,0x13,0x8a,0x6b,\n    0x3a,0x91,0x11,0x41,0x4f,0x67,0xdc,0xea,0x97,0xf2,0xcf,0xce,0xf0,0xb4,0xe6,0x73,\n    0x96,0xac,0x74,0x22,0xe7,0xad,0x35,0x85,0xe2,0xf9,0x37,0xe8,0x1c,0x75,0xdf,0x6e,\n    0x47,0xf1,0x1a,0x71,0x1d,0x29,0xc5,0x89,0x6f,0xb7,0x62,0x0e,0xaa,0x18,0xbe,0x1b,\n    0xfc,0x56,0x3e,0x4b,0xc6,0xd2,0x79,0x20,0x9a,0xdb,0xc0,0xfe,0x78,0xcd,0x5a,0xf4,\n    0x1f,0xdd,0xa8,0x33,0x88,0x07,0xc7,0x31,0xb1,0x12,0x10,0x59,0x27,0x80,0xec,0x5f,\n    0x60,0x51,0x7f,0xa9,0x19,0xb5,0x4a,0x0d,0x2d,0xe5,0x7a,0x9f,0x93,0xc9,0x9c,0xef,\n    0xa0,0xe0,0x3b,0x4d,0xae,0x2a,0xf5,0xb0,0xc8,0xeb,0xbb,0x3c,0x83,0x53,0x99,0x61,\n    0x17,0x2b,0x04,0x7e,0xba,0x77,0xd6,0x26,0xe1,0x69,0x14,0x63,0x55,0x21,0x0c,0x7d,\n}\n\n-- GF(2^8) multiply-by-2 (irreducible polynomial 0x11B)\nlocal function xtime(a)\n    return ((a << 1) ~ (a >= 0x80 and 0x1B or 0x00)) & 0xFF\nend\n\n-- GF(2^8) multiply (used to build InvMixColumns tables)\nlocal function gmul(a, b)\n    local p = 0\n    for _ = 1, 8 do\n        if b & 1 ~= 0 then p = p ~ a end\n        local hi = a & 0x80\n        a = (a << 1) & 0xFF\n        if hi ~= 0 then a = a ~ 0x1B end\n        b = b >> 1\n    end\n    return p\nend\n\n-- Precomputed multiplication tables for InvMixColumns\nlocal mul2  = {}\nlocal mul9  = {}\nlocal mul11 = {}\nlocal mul13 = {}\nlocal mul14 = {}\nfor i = 0, 255 do\n    mul2[i]  = xtime(i)\n    mul9[i]  = gmul(9,  i)\n    mul11[i] = gmul(11, i)\n    mul13[i] = gmul(13, i)\n    mul14[i] = gmul(14, i)\nend\n\n-- AES-128 key schedule: returns array rk[0..10], each a 16-byte flat array\nlocal RCON = {0x01,0x02,0x04,0x08,0x10,0x20,0x40,0x80,0x1B,0x36}\n\nlocal function aes_key_expand(key)\n    -- key is a 16-byte string\n    local w = {}          -- 44 words, 0-indexed; each word = {b0,b1,b2,b3}\n    for i = 0, 3 do\n        local base = i * 4\n        w[i] = { key:byte(base+1), key:byte(base+2),\n                 key:byte(base+3), key:byte(base+4) }\n    end\n    for i = 4, 43 do\n        local temp = { w[i-1][1], w[i-1][2], w[i-1][3], w[i-1][4] }\n        if i % 4 == 0 then\n            -- RotWord then SubWord then XOR Rcon\n            temp = { SBOX[temp[2]], SBOX[temp[3]], SBOX[temp[4]], SBOX[temp[1]] }\n            temp[1] = temp[1] ~ RCON[i // 4]\n        end\n        local p = w[i-4]\n        w[i] = { p[1]~temp[1], p[2]~temp[2], p[3]~temp[3], p[4]~temp[4] }\n    end\n\n    -- Pack into 11 round keys (each: 16-byte flat 1-indexed array)\n    local rk = {}\n    for r = 0, 10 do\n        local k = {}\n        for c = 0, 3 do\n            local word = w[r*4 + c]\n            k[c*4+1] = word[1]; k[c*4+2] = word[2]\n            k[c*4+3] = word[3]; k[c*4+4] = word[4]\n        end\n        rk[r] = k\n    end\n    return rk\nend\n\n-- AddRoundKey\nlocal function add_round_key(st, rk)\n    for i = 1, 16 do st[i] = st[i] ~ rk[i] end\nend\n\n-- SubBytes (forward)\nlocal function sub_bytes(st)\n    for i = 1, 16 do st[i] = SBOX[st[i]] end\nend\n\n-- SubBytes (inverse)\nlocal function inv_sub_bytes(st)\n    for i = 1, 16 do st[i] = ISBOX[st[i]] end\nend\n\n-- ShiftRows (forward: row r shifted left by r)\n-- Column-major layout: row r, col c  →  index c*4+r+1\nlocal function shift_rows(st)\n    local t\n    -- Row 1 (indices 2,6,10,14): shift left 1\n    t=st[2]; st[2]=st[6]; st[6]=st[10]; st[10]=st[14]; st[14]=t\n    -- Row 2 (indices 3,7,11,15): shift left 2  (swap pairs)\n    t=st[3]; st[3]=st[11]; st[11]=t\n    t=st[7]; st[7]=st[15]; st[15]=t\n    -- Row 3 (indices 4,8,12,16): shift left 3  (= rotate right 1)\n    t=st[4]; st[4]=st[16]; st[16]=st[12]; st[12]=st[8]; st[8]=t\nend\n\n-- ShiftRows (inverse: row r shifted right by r)\nlocal function inv_shift_rows(st)\n    local t\n    -- Row 1: shift right 1  (= rotate left 3)\n    t=st[14]; st[14]=st[10]; st[10]=st[6]; st[6]=st[2]; st[2]=t\n    -- Row 2: shift right 2  (swap pairs)\n    t=st[3]; st[3]=st[11]; st[11]=t\n    t=st[7]; st[7]=st[15]; st[15]=t\n    -- Row 3: shift right 3  (= rotate left 1)\n    t=st[4]; st[4]=st[8]; st[8]=st[12]; st[12]=st[16]; st[16]=t\nend\n\n-- MixColumns (forward): compact XOR form, avoids extra table lookups\nlocal function mix_columns(st)\n    for c = 0, 3 do\n        local b = c*4+1\n        local a0,a1,a2,a3 = st[b],st[b+1],st[b+2],st[b+3]\n        local t = a0 ~ a1 ~ a2 ~ a3\n        st[b]   = a0 ~ t ~ xtime(a0~a1)\n        st[b+1] = a1 ~ t ~ xtime(a1~a2)\n        st[b+2] = a2 ~ t ~ xtime(a2~a3)\n        st[b+3] = a3 ~ t ~ xtime(a3~a0)\n    end\nend\n\n-- InvMixColumns (inverse): uses precomputed GF tables\nlocal function inv_mix_columns(st)\n    for c = 0, 3 do\n        local b = c*4+1\n        local a0,a1,a2,a3 = st[b],st[b+1],st[b+2],st[b+3]\n        st[b]   = mul14[a0] ~ mul11[a1] ~ mul13[a2] ~ mul9[a3]\n        st[b+1] = mul9[a0]  ~ mul14[a1] ~ mul11[a2] ~ mul13[a3]\n        st[b+2] = mul13[a0] ~ mul9[a1]  ~ mul14[a2] ~ mul11[a3]\n        st[b+3] = mul11[a0] ~ mul13[a1] ~ mul9[a2]  ~ mul14[a3]\n    end\nend\n\n-- Encrypt one 16-byte block (string) with pre-expanded round keys\nlocal function aes_enc_block(pt, rk)\n    local st = { pt:byte(1, 16) }\n    add_round_key(st, rk[0])\n    for r = 1, 9 do\n        sub_bytes(st); shift_rows(st); mix_columns(st); add_round_key(st, rk[r])\n    end\n    sub_bytes(st); shift_rows(st); add_round_key(st, rk[10])\n    return string.char(table.unpack(st))\nend\n\n-- Decrypt one 16-byte block (string) with pre-expanded round keys\nlocal function aes_dec_block(ct, rk)\n    local st = { ct:byte(1, 16) }\n    add_round_key(st, rk[10])\n    for r = 9, 1, -1 do\n        inv_shift_rows(st); inv_sub_bytes(st)\n        add_round_key(st, rk[r]); inv_mix_columns(st)\n    end\n    inv_shift_rows(st); inv_sub_bytes(st); add_round_key(st, rk[0])\n    return string.char(table.unpack(st))\nend\n\n-- AES-128-ECB encrypt/decrypt (single 16-byte block)\nfunction aes_ecb_encrypt(plaintext, key)\n    return aes_enc_block(plaintext, aes_key_expand(key))\nend\n\nfunction aes_ecb_decrypt(ciphertext, key)\n    return aes_dec_block(ciphertext, aes_key_expand(key))\nend\n\n-- AES-128-CBC encrypt (no PKCS7; input must be a multiple of 16 bytes)\nlocal function _cbc_enc(plaintext, key, iv)\n    local rk   = aes_key_expand(key)\n    local out  = {}\n    local prev = { iv:byte(1, 16) }\n    for i = 1, #plaintext, 16 do\n        local blk = { plaintext:byte(i, i+15) }\n        for j = 1, 16 do blk[j] = blk[j] ~ prev[j] end\n        local ct = aes_enc_block(string.char(table.unpack(blk)), rk)\n        out[#out+1] = ct\n        prev = { ct:byte(1, 16) }\n    end\n    return table.concat(out)\nend\n\n-- AES-128-CBC decrypt (no PKCS7; input must be a multiple of 16 bytes)\nlocal function _cbc_dec(ciphertext, key, iv)\n    local rk   = aes_key_expand(key)\n    local out  = {}\n    local prev = { iv:byte(1, 16) }\n    for i = 1, #ciphertext, 16 do\n        local blk = ciphertext:sub(i, i+15)\n        local pt  = { aes_dec_block(blk, rk):byte(1, 16) }\n        for j = 1, 16 do pt[j] = pt[j] ~ prev[j] end\n        out[#out+1] = string.char(table.unpack(pt))\n        prev = { blk:byte(1, 16) }\n    end\n    return table.concat(out)\nend\n\nlocal function increment_iv(iv)\n    local b1 = ((iv:byte(1) + 1) & 0xFF)\n    return md5(string.char(b1) .. iv:sub(2))\nend\n\nfunction aes_cbc_encrypt(plaintext, key, iv_ref)\n    local cur_iv = iv_ref[1]\n    iv_ref[1] = increment_iv(cur_iv)\n    local pad = (-#plaintext) % 16\n    if pad > 0 then plaintext = plaintext .. (\"\\0\"):rep(pad) end\n    return _cbc_enc(plaintext, key, cur_iv)\nend\n\nfunction aes_cbc_decrypt(ciphertext, key, iv_ref)\n    local cur_iv = iv_ref[1]\n    iv_ref[1] = increment_iv(cur_iv)\n    return _cbc_dec(ciphertext, key, cur_iv)\nend\n"
    },
    {
      "name": "pin",
      "isMain": false,
      "isOpen": false,
      "content": "local function pin_to_bcd(pin)\n    local result, shift = 0, 0\n    repeat\n        result = result | ((pin % 10) << shift)\n        shift  = shift + 4\n        pin    = pin // 10\n    until pin == 0\n    return result\nend\n\nfunction derive_key(pin, mac_int)\n    local bcd = pin_to_bcd(pin)\n    local buf = string.char(\n        (bcd    >> 24) & 0xFF,\n        (bcd    >> 16) & 0xFF,\n        (bcd    >>  8) & 0xFF,\n         bcd           & 0xFF,\n        0xAA,\n         mac_int        & 0xFF,   -- MAC little-endian (LSB first)\n        (mac_int >>  8) & 0xFF,\n        (mac_int >> 16) & 0xFF,\n        (mac_int >> 24) & 0xFF,\n        (mac_int >> 32) & 0xFF,\n        (mac_int >> 40) & 0xFF,\n        0x55,\n        (bcd    >> 24) & 0xFF,\n        (bcd    >> 16) & 0xFF,\n        (bcd    >>  8) & 0xFF,\n         bcd           & 0xFF\n    )\n    return md5(buf)\nend\n\nfunction bytes_to_hex(s)\n    return (s:gsub(\".\", function(c) return (\"%02X\"):format(c:byte()) end))\nend\n\nfunction hex_to_bytes(h)\n    return (h:gsub(\"..\", function(hh) return string.char(tonumber(hh, 16)) end))\nend\n\nmath.randomseed(os.time())\n\nfunction random_bytes(n)\n    local bytes = \"\"\n    for i = 1, n do\n        bytes = bytes .. string.char(math.random(0, 255))\n    end\n    return bytes\nend\n\nlocal ESC_SEQ = {\n    [0x00] = \"\\xFE\\x30\",\n    [0x0D] = \"\\xFE\\x31\",\n    [0x0A] = \"\\xFE\\x32\",\n    [0xFE] = \"\\xFE\\xFE\",\n}\n\nfunction escape(data, buff_len)\n    local num2 = 0\n    for i = 1, buff_len do\n        num2 = num2 + (ESC_SEQ[data:byte(i)] and 2 or 1)\n    end\n    if num2 == buff_len then return data end\n\n    local t = {}\n    for i = 1, buff_len do\n        t[#t+1] = ESC_SEQ[data:byte(i)] or string.char(data:byte(i))\n    end\n    t[#t+1] = \"\\x0A\"\n    return table.concat(t)\nend\n\nfunction unescape(data)\n    local t, i = {}, 1\n    while i <= #data do\n        local b = data:byte(i)\n        if b == 0xFE and i < #data then\n            local code = data:byte(i + 1)\n            if     code == 0x30 then t[#t+1] = \"\\x00\"\n            elseif code == 0x31 then t[#t+1] = \"\\x0D\"\n            elseif code == 0x32 then t[#t+1] = \"\\x0A\"\n            elseif code == 0xFE then t[#t+1] = \"\\xFE\"\n            else                     t[#t+1] = string.char(code)\n            end\n            i = i + 2\n        else\n            t[#t+1] = string.char(b)\n            i = i + 1\n        end\n    end\n    return table.concat(t)\nend\n"
    }
  ]
}
